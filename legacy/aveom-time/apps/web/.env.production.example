# Copy to  apps/web/.env.production  and fill from your Firebase web app config
# (Project settings -> General -> Your apps -> SDK setup and configuration).
# These values are NOT secret — they ship in the client bundle.

VITE_USE_EMULATORS=0

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MSG_SENDER_ID=
VITE_FB_APP_ID=

VITE_FUNCTIONS_REGION=asia-south1
