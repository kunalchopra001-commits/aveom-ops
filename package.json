{
  "name": "aveom-ops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install && npm --prefix functions install",
    "dev": "npm run dev --workspace @aveom-ops/web",
    "build": "npm run build --workspace @aveom-ops/web && npm --prefix functions run build",
    "typecheck": "npm run typecheck --workspace @aveom-ops/web && npm --prefix functions run typecheck",
    "test": "node --experimental-strip-types --test shared/*.test.ts",
    "dev:emu": "npm run dev:emu --workspace @aveom-ops/web",
    "e2e": "node tests/e2e.emulator.mjs",
    "seed": "node functions/scripts/seed-emulator.mjs"
  }
}
