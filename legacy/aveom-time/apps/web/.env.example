# Copy to .env.local and fill from your Firebase project's web app config.
# For local emulator development you can leave these as-is and set VITE_USE_EMULATORS=1.

VITE_USE_EMULATORS=1

VITE_FB_API_KEY=demo-key
VITE_FB_AUTH_DOMAIN=aveom-time-dev.firebaseapp.com
VITE_FB_PROJECT_ID=aveom-time-dev
VITE_FB_STORAGE_BUCKET=aveom-time-dev.appspot.com
VITE_FB_MSG_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:0000000000000000

VITE_FUNCTIONS_REGION=asia-south1
